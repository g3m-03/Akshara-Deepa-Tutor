<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStrengthMapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Strength Map"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvStrengthMapDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Performance based on average quiz scores."
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvStrengthMapTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <com.github.mikephil.charting.charts.RadarChart
            android:id="@+id/radarChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvStrengthMapDesc" />

        <TextView
            android:id="@+id/tvMasteryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject Mastery"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/radarChart"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Science Mastery Card -->
        <include
            android:id="@+id/cardScienceMastery"
            layout="@layout/item_mastery_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvMasteryTitle" />

        <!-- Math Mastery Card -->
        <include
            android:id="@+id/cardMathMastery"
            layout="@layout/item_mastery_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardScienceMastery" />

        <!-- Social Mastery Card -->
        <include
            android:id="@+id/cardSocialMastery"
            layout="@layout/item_mastery_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardMathMastery" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
